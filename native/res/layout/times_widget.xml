<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wgt_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#E60F1419">

    <TextView
        android:id="@+id/wgt_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="افق شرعی"
        android:textColor="#99EEF4FA"
        android:textSize="12sp"
        android:textDirection="rtl" />

    <TextView
        android:id="@+id/wgt_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="اذان بعدی"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textDirection="rtl"
        android:paddingTop="4dp" />

    <TextView
        android:id="@+id/wgt_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="--:--"
        android:textColor="#FF3DD6C3"
        android:textSize="30sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:textDirection="ltr"
        android:paddingTop="2dp" />

    <TextView
        android:id="@+id/wgt_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#99EEF4FA"
        android:textSize="12sp"
        android:textDirection="rtl"
        android:paddingTop="2dp" />
</LinearLayout>
