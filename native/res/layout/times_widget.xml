<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wgt_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/wgt_bg">

    <!-- City / header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/wgt_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="افق شرعی"
            android:textColor="#A8F7EFE4"
            android:textSize="12sp"
            android:textDirection="rtl"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/wgt_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="اذان بعدی"
            android:textColor="#E8B86D"
            android:textSize="11sp"
            android:background="@drawable/wgt_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textDirection="rtl" />
    </LinearLayout>

    <!-- Accent bar -->
    <ImageView
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:src="@drawable/wgt_accent_bar"
        android:contentDescription="@null" />

    <!-- Prayer name -->
    <TextView
        android:id="@+id/wgt_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="اذان ظهر"
        android:textColor="#FFFFFFF0"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textDirection="rtl"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Big time -->
    <TextView
        android:id="@+id/wgt_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="--:--"
        android:textColor="#E8B86D"
        android:textSize="34sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:textDirection="ltr"
        android:paddingTop="2dp"
        android:letterSpacing="0.04" />

    <!-- Remaining -->
    <TextView
        android:id="@+id/wgt_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#99F7EFE4"
        android:textSize="12sp"
        android:textDirection="rtl"
        android:paddingTop="4dp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
