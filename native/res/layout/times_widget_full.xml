<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wgt_full_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/wgt_bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/wgt_full_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="اوقات امروز"
            android:textColor="#E8B86D"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textDirection="rtl"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/wgt_full_next_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#A8F7EFE4"
            android:textSize="11sp"
            android:textDirection="rtl"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Accent -->
    <ImageView
        android:layout_width="40dp"
        android:layout_height="3dp"
        android:layout_marginBottom="10dp"
        android:src="@drawable/wgt_accent_bar"
        android:contentDescription="@null" />

    <!-- Grid of 6 prayer times: 3 columns x 2 rows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 1: Fajr, Sunrise, Dhuhr -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp">
                <TextView
                    android:id="@+id/wgt_full_n1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="صبح"
                    android:textColor="#99F7EFE4"
                    android:textSize="11sp"
                    android:textDirection="rtl" />
                <TextView
                    android:id="@+id/wgt_full_t1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="#FFFFFFF0"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textDirection="ltr"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp">
                <TextView
                    android:id="@+id/wgt_full_n2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="طلوع"
                    android:textColor="#99F7EFE4"
                    android:textSize="11sp"
                    android:textDirection="rtl" />
                <TextView
                    android:id="@+id/wgt_full_t2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="#FFFFFFF0"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textDirection="ltr"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp">
                <TextView
                    android:id="@+id/wgt_full_n3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ظهر"
                    android:textColor="#99F7EFE4"
                    android:textSize="11sp"
                    android:textDirection="rtl" />
                <TextView
                    android:id="@+id/wgt_full_t3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="#FFFFFFF0"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textDirection="ltr"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Asr, Maghrib, Isha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp">
                <TextView
                    android:id="@+id/wgt_full_n4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="عصر"
                    android:textColor="#99F7EFE4"
                    android:textSize="11sp"
                    android:textDirection="rtl" />
                <TextView
                    android:id="@+id/wgt_full_t4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="#FFFFFFF0"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textDirection="ltr"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp">
                <TextView
                    android:id="@+id/wgt_full_n5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مغرب"
                    android:textColor="#99F7EFE4"
                    android:textSize="11sp"
                    android:textDirection="rtl" />
                <TextView
                    android:id="@+id/wgt_full_t5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="#FFFFFFF0"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textDirection="ltr"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp">
                <TextView
                    android:id="@+id/wgt_full_n6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="عشا"
                    android:textColor="#99F7EFE4"
                    android:textSize="11sp"
                    android:textDirection="rtl" />
                <TextView
                    android:id="@+id/wgt_full_t6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="#FFFFFFF0"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textDirection="ltr"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
