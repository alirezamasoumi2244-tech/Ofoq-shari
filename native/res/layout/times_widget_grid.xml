<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wgt_g_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/wgt_bg">

    <TextView
        android:id="@+id/wgt_g_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="اوقات امروز"
        android:textColor="#E8B86D"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textDirection="rtl"
        android:paddingBottom="6dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- 2 rows x 3 cols -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="2dp">
                <TextView android:id="@+id/wgt_g_n1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="صبح" android:textColor="#99F7EFE4" android:textSize="10sp" android:textDirection="rtl" />
                <TextView android:id="@+id/wgt_g_t1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--:--" android:textColor="#FFFFFFF0" android:textSize="13sp" android:textStyle="bold" android:textDirection="ltr" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="2dp">
                <TextView android:id="@+id/wgt_g_n2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="طلوع" android:textColor="#99F7EFE4" android:textSize="10sp" android:textDirection="rtl" />
                <TextView android:id="@+id/wgt_g_t2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--:--" android:textColor="#FFFFFFF0" android:textSize="13sp" android:textStyle="bold" android:textDirection="ltr" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="2dp">
                <TextView android:id="@+id/wgt_g_n3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ظهر" android:textColor="#99F7EFE4" android:textSize="10sp" android:textDirection="rtl" />
                <TextView android:id="@+id/wgt_g_t3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--:--" android:textColor="#FFFFFFF0" android:textSize="13sp" android:textStyle="bold" android:textDirection="ltr" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="2dp">
                <TextView android:id="@+id/wgt_g_n4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="عصر" android:textColor="#99F7EFE4" android:textSize="10sp" android:textDirection="rtl" />
                <TextView android:id="@+id/wgt_g_t4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--:--" android:textColor="#FFFFFFF0" android:textSize="13sp" android:textStyle="bold" android:textDirection="ltr" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="2dp">
                <TextView android:id="@+id/wgt_g_n5" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="مغرب" android:textColor="#99F7EFE4" android:textSize="10sp" android:textDirection="rtl" />
                <TextView android:id="@+id/wgt_g_t5" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--:--" android:textColor="#FFFFFFF0" android:textSize="13sp" android:textStyle="bold" android:textDirection="ltr" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="2dp">
                <TextView android:id="@+id/wgt_g_n6" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="عشا" android:textColor="#99F7EFE4" android:textSize="10sp" android:textDirection="rtl" />
                <TextView android:id="@+id/wgt_g_t6" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--:--" android:textColor="#FFFFFFF0" android:textSize="13sp" android:textStyle="bold" android:textDirection="ltr" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
